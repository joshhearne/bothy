{
  "name": "bothy",
  "version": "0.0.0",
  "description": "Self-hosted structured IT documentation",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${APP_PORT:-3080}",
    "build": "next build && npm run build:scripts",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts --bundle --platform=node --format=esm --target=node22 --packages=bundle --external:pg-native --external:cloudflare:sockets --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --outdir=dist",
    "start": "next start -H 0.0.0.0 -p ${APP_PORT:-3080}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@noble/hashes": "^2.4.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "heic-convert": "^2.1.0",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tiptap-markdown": "^0.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^18.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
