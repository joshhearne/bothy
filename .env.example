DATABASE_URL=postgres://bothy:changeme@db:5432/bothy
POSTGRES_USER=bothy
POSTGRES_DB=bothy
POSTGRES_PASSWORD=changeme
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Host port the app is published on (container always listens on 3000).
APP_PORT=3080
# 127.0.0.1 keeps the port off the network when a tunnel or proxy fronts it.
APP_BIND=0.0.0.0
# Container limits, so one busy upload cannot starve the rest of the host.
APP_CPUS=2
APP_MEMORY=1g
DB_CPUS=2
DB_MEMORY=1g
APP_URL=http://localhost:3080
# Interface language for new visitors: en-US or en-GB. Readers can switch.
APP_LOCALE=en-US
# Wording of the seeded starter content: en-US or en-GB.
SEED_LOCALE=en-US
# Lets a scheduler drive webhook retries when nothing holds a timer
# (Cloudflare Cron Triggers, or system cron). Leave empty to keep it disabled.
CRON_SECRET=
# Optional OIDC (Entra ID, Google, Authentik, Keycloak)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Attachments: local volume by default, S3-compatible optional
# local | s3 | r2
STORAGE_DRIVER=local
STORAGE_PATH=/data/uploads
MAX_UPLOAD_MB=25
# Required when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Vault integration (optional, see docs/VAULT_INTEGRATION.md)
# link | bw_serve | op_connect | hashicorp_kv
VAULT_MODE=link

# 1Password, through a self-hosted Connect server on your own network.
# Start it with: docker compose --profile onepassword up -d
# The credentials file goes in ./secrets/1password-credentials.json (chmod 600).
OP_CONNECT_URL=http://op-connect-api:8080
OP_CONNECT_TOKEN=

# HashiCorp Vault, against a KV v2 mount.
HASHICORP_VAULT_ADDR=
HASHICORP_VAULT_TOKEN=
HASHICORP_VAULT_MOUNT=secret                       # link | bw_serve
BW_SERVER_URL=https://vault.example.com   # Vaultwarden, self-hosted Bitwarden, or https://vault.bitwarden.com
BW_WEB_VAULT_URL=https://vault.example.com
BW_CLIENTID=
BW_CLIENTSECRET=
BW_SERVE_URL=http://bw-serve:8087
# Only when the sidecar sits behind a Cloudflare Tunnel rather than a private network
BW_SERVE_ACCESS_CLIENT_ID=
BW_SERVE_ACCESS_CLIENT_SECRET=
BW_SYNC_INTERVAL_MIN=5
# Master password goes in ./secrets/bw_master_password.txt (chmod 600), not here
# Bitwarden Public API add-on (Teams/Enterprise only)
BW_PUBLIC_API_CLIENT_ID=
BW_PUBLIC_API_CLIENT_SECRET=
